{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Volume App",
  "version": "1.0.0",
  "identifier": "com.antigravity.volumeapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Volume App",
        "label": "main",
        "width": 300,
        "height": 80,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
